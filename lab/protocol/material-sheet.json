  "generic_rules": [
    {
      "id": "g-black",
      "text": "Nur schwarze Linien: kein Weiß, keine Farbe, keine Lavierung, kein Wasser."
    },
    {
      "id": "g-no-erase",
      "text": "Tinte als nicht radierbar behandeln; vorhandene Linien weder übermalen noch korrigieren."
    },
    {
      "id": "g-test",
      "text": "Vor jedem Schritt einen Probestrich auf einem Reststück desselben Papiers machen."
    },
    {
      "id": "g-dry",
      "text": "Für keinen Stift ist eine Trockenzeit belegt: vor dem Darüberzeichnen oder Berühren warten und mit dem Probestrich prüfen."
    },
    {
      "id": "g-pressure",
      "text": "Mit leichtem Druck zeichnen; Strichstärke über die Stiftgröße steuern, nicht über Druck."
    },
    {
      "id": "g-small",
      "text": "Kleine Schritte: lieber zu wenig als zu viel, jederzeit stoppen können."
    },
    {
      "id": "g-unknown",
      "text": "Bei unbekanntem Stift oder Papier: dünnste vorhandene Spitze wählen und Durchschlagen am Probestück prüfen."
    }
  ]
}
