{
  "name": "nextstroke",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.e2e.json",
    "deps": "depcruise apps packages --config .dependency-cruiser.cjs",
    "licenses": "node scripts/check_licenses.mjs",
    "pnpm-version": "node scripts/check_pnpm.mjs",
    "test": "vitest run --coverage",
    "build": "pnpm --filter @nextstroke/web build",
    "check": "pnpm run pnpm-version && pnpm run lint && pnpm run typecheck && pnpm run deps && pnpm run licenses && pnpm run test && pnpm run build",
    "e2e": "pnpm --filter @nextstroke/web e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.3",
    "dependency-cruiser": "18.5.0",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
